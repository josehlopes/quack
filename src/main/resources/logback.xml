<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Appender para log no console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender para UserService -->
    <appender name="USER_SERVICE_FILE" class="ch.qos.logback.core.FileAppender">
        <file>src/main/java/com/thigas/quack/logs/UserService.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender para UserLessonService -->
    <appender name="USER_LESSON_SERVICE_FILE" class="ch.qos.logback.core.FileAppender">
        <file>src/main/java/com/thigas/quack/logs/UserLessonService.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender para UserRoadmapService -->
    <appender name="USER_ROADMAP_SERVICE_FILE" class="ch.qos.logback.core.FileAppender">
        <file>src/main/java/com/thigas/quack/logs/UserRoadmapService.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender para UserStepService -->
    <appender name="USER_STEP_SERVICE_FILE" class="ch.qos.logback.core.FileAppender">
        <file>src/main/java/com/thigas/quack/logs/UserStepService.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender para UserTaskService -->
    <appender name="USER_TASK_SERVICE_FILE" class="ch.qos.logback.core.FileAppender">
        <file>src/main/java/com/thigas/quack/logs/UserTaskService.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger, usando o appender CONSOLE -->
    <root level="debug">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- Logger específico para UserService -->
    <logger name="com.thigas.quack.UseCase.Service.UserService" level="debug">
        <appender-ref ref="USER_SERVICE_FILE" />
    </logger>

    <!-- Logger específico para UserLessonService -->
    <logger name="com.thigas.quack.UseCase.Service.UserLessonService" level="debug">
        <appender-ref ref="USER_LESSON_SERVICE_FILE" />
    </logger>

    <!-- Logger específico para UserRoadmapService -->
    <logger name="com.thigas.quack.UseCase.Service.UserRoadmapService" level="debug">
        <appender-ref ref="USER_ROADMAP_SERVICE_FILE" />
    </logger>

    <!-- Logger específico para UserStepService -->
    <logger name="com.thigas.quack.UseCase.Service.UserStepService" level="debug">
        <appender-ref ref="USER_STEP_SERVICE_FILE" />
    </logger>

    <!-- Logger específico para UserTaskService -->
    <logger name="com.thigas.quack.UseCase.Service.UserTaskService" level="debug">
        <appender-ref ref="USER_TASK_SERVICE_FILE" />
    </logger>
</configuration>