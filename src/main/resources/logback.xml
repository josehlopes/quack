<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Appender para log no arquivo -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>src/main/java/com/thigas/quack/Logs/app.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender para log no console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger, usando o appender FILE -->
    <root level="debug">
        <appender-ref ref="FILE" />
    </root>

    <!-- Logger específico para a entidade CommonStatistics -->
    <logger name="com.thigas.quack.Domain.Entity.Implementation.CommonStatistics" level="debug">
        <appender-ref ref="FILE" />
    </logger>

    <!-- Logger específico para a entidade User -->
    <logger name="com.thigas.quack.Domain.Entity.Implementation.User" level="info">
        <appender-ref ref="FILE" />
    </logger>

    <!-- Logger para todo o pacote 'com.thigas.quack.Domain.Entity' -->
    <logger name="com.thigas.quack.Domain.Entity" level="info">
        <appender-ref ref="FILE" />
    </logger>

    <!-- Logger para pacotes específicos ou classes específicas -->
    <logger name="com.thigas.quack.Service" level="warn">
        <appender-ref ref="CONSOLE" />
    </logger>

</configuration>
